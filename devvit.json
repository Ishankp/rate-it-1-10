{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "rate-it-1-10",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create 1-10 poll",
        "description": "Create a timed opinion scale poll",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-poll"
      }
    ]
  },
  "forms": {
    "pollForm": "/internal/form/poll-create"
  },
  "scheduler": {
    "tasks": {
      "poll-reveal": {
        "endpoint": "/internal/scheduler/poll-reveal"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "rate_it_1_10_dev"
  }
}